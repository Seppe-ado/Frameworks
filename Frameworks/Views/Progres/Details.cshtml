@model Frameworks.Models.Progres

@{
    ViewData["Title"] = "Details";
}

<h1>@Localizer["Details"]</h1>

<div>
    <h4>@Localizer["Progres"]</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Localizer["User ID"]
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FrameworksUserId)
        </dd>
        <dt class = "col-sm-2">
            @Localizer["Comment"]
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Comment)
        </dd>
        <dt class = "col-sm-2">
            @Localizer["Completed"]
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Completed)
        </dd>
        <dt class = "col-sm-2">
            @Localizer["Date Completed"]
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateTime)
        </dd>
        
        <dt class = "col-sm-2">
            @Localizer["Route ID"]
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Route.Id)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">@Localizer["Edit"]</a> |
    <a asp-action="Index">@Localizer["Back to List"]</a>
</div>
